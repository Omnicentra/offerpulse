# Dashboard App Environment Variables
# Validation: @t3-oss/env-nextjs (see env.ts). Set SKIP_ENV_VALIDATION=true to skip during build if needed.

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Better-auth
BETTER_AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001

# Inngest
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# AI
OPENAI_API_KEY=your-openai-api-key
# or ANTHROPIC_API_KEY=your-anthropic-api-key

# Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=offerpulse-screenshots

# Notifications
RESEND_API_KEY=your-resend-api-key

# PostHog (required - for analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_ENVIRONMENT=dev

# App URLs (local development)
NEXT_PUBLIC_MARKETING_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_APP_URL=http://localhost:3001

# For production, set these to your actual domains:
# NEXT_PUBLIC_MARKETING_APP_URL=https://offerpulse.com
# NEXT_PUBLIC_DASHBOARD_APP_URL=https://app.offerpulse.com
