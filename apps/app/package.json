{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:tls": "BETTER_AUTH_URL=https://localhost:3001 NEXT_PUBLIC_DASHBOARD_APP_URL=https://localhost:3001 next dev --experimental-https -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:migrate:prod": "doppler run -p offerpulse-app -c prd -- tsx src/server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "pnpm with-env tsx src/server/db/seed.ts",
    "db:drop": "drizzle-kit drop",
    "with-env": "dotenv -e .env.local --"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@aws-sdk/client-s3": "^3.996.0",
