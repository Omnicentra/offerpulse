    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "happy-dom": "^20.8.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
