# Marketing App Environment Variables

# App URLs (local development)
NEXT_PUBLIC_MARKETING_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_APP_URL=http://localhost:3001

# For production, set these to your actual domains:
# NEXT_PUBLIC_MARKETING_APP_URL=https://offerpulse.com
# NEXT_PUBLIC_DASHBOARD_APP_URL=https://app.offerpulse.com

# Stripe (required for checkout)
STRIPE_SECRET_KEY=sk_test_...
# Optional: for webhook signature verification (get from Stripe Dashboard or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: price lookup key for Snapshot Report (default: snapshot-report)
STRIPE_PRICE_LOOKUP_KEY=snapshot-report
