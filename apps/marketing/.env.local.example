# Marketing App Environment Variables

# App URLs (local development)
NEXT_PUBLIC_MARKETING_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_APP_URL=http://localhost:3001

# For production, set these to your actual domains:
# NEXT_PUBLIC_MARKETING_APP_URL=https://offerpulse.io
# NEXT_PUBLIC_DASHBOARD_APP_URL=https://app.offerpulse.io

# PostHog Analytics (required for tracking)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Environment (dev, stg, prd)
# This is automatically set by Doppler but can be overridden
NEXT_PUBLIC_ENVIRONMENT=dev
DOPPLER_ENVIRONMENT=dev

# Stripe (required for checkout)
STRIPE_SECRET_KEY=sk_test_...
# Optional: for webhook signature verification (get from Stripe Dashboard or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: price lookup key for Snapshot Report (default: snapshot-report)
STRIPE_PRICE_LOOKUP_KEY=snapshot-report

# Resend (required for sending emails)
RESEND_API_KEY=re_...

# Airtable (required for database)
AIRTABLE_API_KEY=pat...
# Optional: Airtable base ID (default: app2FMikxa9F6erFY)
AIRTABLE_BASE_ID=app2FMikxa9F6erFY

# Firecrawl (required for free tools: offer snapshot, discount detector, etc.)
FIRECRAWL_API_KEY=fc-...

# Optional: Discount Detector — /map URL cap (10–500, default 100)
# DISCOUNT_DETECTOR_MAP_LIMIT=100
# Optional: max same-origin pages to /scrape after map (1–25, default 10)
# DISCOUNT_DETECTOR_SCRAPE_PAGES=10
# Optional: set to "true" to fall back to direct HTML fetch + heuristics when map/scrape finds nothing
# DISCOUNT_DETECTOR_REGEX_FALLBACK=true
